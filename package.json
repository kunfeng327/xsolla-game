{
  "name": "starbreak-extraction-demo",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "node scripts/verify.cjs",
    "build:offline": "npm run build && node scripts/build-standalone.cjs",
    "format": "prettier --write src scripts package.json tsconfig.json vite.config.ts .prettierrc.json",
    "format:check": "prettier --check src scripts package.json tsconfig.json vite.config.ts .prettierrc.json"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.4.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
